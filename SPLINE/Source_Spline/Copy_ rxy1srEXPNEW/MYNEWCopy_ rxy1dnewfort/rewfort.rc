/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

idd_txy DIALOGEX 40, 40, 228, 92
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Оптимизация"
FONT 12, "MS Sans Serif", 0, 0, 0x1
BEGIN
    PUSHBUTTON      " Прерывание счёта",cancel,130,7,71,14
    LTEXT           "Внешняя итерация",IDC_STATIC,11,9,67,8
    EDITTEXT        vne,80,7,40,12,ES_AUTOHSCROLL
    LTEXT           "Остаток итераций",IDC_STATIC,11,26,63,8
    EDITTEXT        ost,80,24,40,12,ES_AUTOHSCROLL
    LTEXT           " Критерий",Cr,10,40,61,8
    EDITTEXT        crit,80,39,40,12,ES_AUTOHSCROLL
    LTEXT           " Невязка",NEv1,11,56,56,8
    EDITTEXT        nev,80,53,40,12,ES_AUTOHSCROLL
    LTEXT           "Результат",err,14,74,105,8
END


