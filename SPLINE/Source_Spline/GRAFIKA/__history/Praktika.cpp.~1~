/***********************************************************
Обработка события нажатия клавиши мыши
Возможно
-перемещение, если стоит флаг isMove = true
-добавление границы, если был двойной щелчек (флаг isDbClick = true;)
-активания границы для редактирования
**************************************************************/

void __fastcall TForm1::FildMouseDown(TObject *Sender, TMouseButton Button,
      TShiftState Shift, int X, int Y)
{

   MousePressed = true;
   xprev = X;
   yprev = Y;



   if (isMove)
        {
          Move(); //перемещение границы надо пересчитать пикетаж !!!
          return;
        }

   if (Button!=mbLeft)
      return;
   if (isDbClick)     //добавление границы
     {
        Form2->ShowModal();  //показать диалоговое окно
        isDbClick = false;
     }
    else  //возможно редактирование границы
      {
        if (isActive == true)  //уже выбрана граница для редактирования
          {
          ShowMessage("Уже выбрана граница для редактирования");
          return;
            }
        //проверяем попали ли линию-границу
        //struct region *curr = new region; лишнее??
        curr = begin;
        while (curr!=NULL)
        {
          if ((Xp(curr->regionX)>=Form1->x1-1)&&(Xp(curr->regionX)<=Form1->x1+1))
                        {
                                if (curr->next==NULL)
                                  {
                                    ShowMessage("Нельзя удалить или переместить последнюю границу");
                                    return;
                                  }
                           Fild->Canvas->Pen->Color = clRed;
                           Fild->Canvas->Pen->Width = 1;
                           Fild->Canvas->MoveTo(Xp(curr->regionX), Fild->Height);
                           Fild->Canvas->LineTo(Xp(curr->regionX), 0);
                           curr->active = true;
                           isActive = true; //выбрана граница для реактирования

                           //сделать активными кнопки и меню
                           Form1->btnDisactive->Enabled = true;
                           Form1->btnDelete->Enabled = true;

                           Form1->btnMove->Enabled = true;
                           Form1->N2->Enabled = true;
                           Form1->N3->Enabled = true;
                           Form1->N4->Enabled = true;
                           break;
                        }
                else
                        curr = curr->next;
             }
        }
}
/***********************************************************
Удаление границы
**************************************************************/
void TForm1::Delete()
{
//  struct region *curr = new region;

  curr = begin;

        while (curr!=NULL)
        {
          if (curr->active == true)
            {
              if (curr==begin)
                 begin = curr->next; //нужно удалить первый
              else
                {
                 if (curr->next==NULL)
                   curr->prev->next = NULL;  //нужно удалить последний
                 else
                   {
                    curr->next->prev = curr->prev;
                    curr->prev->next = curr->next;
                   }

                 if (curr->next->type == 2)  //если окружность пересчитать кривизну
                 {
                   if (!Form2->krivizna(curr->next))
                     {ShowMessage ("Ошибка в рассчете кривизны");}
                 }
              }

             }
            curr = curr->next;
          }
    isActive = false;
    rQuantity--;
    Form1->btnDelete->Enabled = false;
    Form1->btnDisactive->Enabled = false;
    Form1->btnMove->Enabled = false;
    Form1->N2->Enabled = false;
    Form1->N3->Enabled = false;
    Form1->N4->Enabled = false;
    ReDraw();
}
/***********************************************************
Деактивация границы - отменить выбор
**************************************************************/
void TForm1::Disactive()
{
  isActive = false;
  isMove = false;
  //struct region *curr = new region;

  curr = begin;

        while (curr!=NULL)
        {
          if (curr->active == true)
             {
              curr->active = false;
              Fild->Canvas->Pen->Color = clBlue;
              Fild->Canvas->Pen->Width = 1;
              Fild->Canvas->MoveTo(Xp(curr->regionX),Fild->Height);
              Fild->Canvas->LineTo(Xp(curr->regionX), 0);
              break;
             }
          curr = curr->next;
         }
    Form1->btnDelete->Enabled = false;
    Form1->btnDisactive->Enabled = false;
    Form1->btnMove->Enabled = false;
    Form1->N2->Enabled = false;
    Form1->N3->Enabled = false;
    Form1->N4->Enabled = false;
}

