  if(rpfile==NULL)
  {
    ShowMessage("Не задано соответствие пикетажа.ENTER");
    return false;
  }
  int i=0;
  double s;
  while(!feof(rpfile))
  {
    fscanf(rpfile,"%lf",&s);
    if(feof(rpfile))break;
    fscanf(rpfile,"%f%lf",&rp[i].pl,&rp[i].km);
    rp[i].pk=(long)s;
    i++;
  }
  krp=i;
  fclose(rpfile);
  QPoint = 0;

  ifstream Fin;

  Fin.open(igl_name);//исходная углограмма своя на участке

