/*************************************************************************
Запись в выходной файл
**************************************************************************/
bool TForm1::WriteToOutputFile()
{
   ofstream  Fout;
//   ShowMessage(uch_name);
   Fout.open(uch_name);  //для повторного счёта при схеме запись в схема.dat
   if (!Fout)//запись в .g??
      {
         ShowMessage ("Не удалось создать файл. Данные не будут сохранены");
        return false;
      }
     Fout<<rQuantity;
//     struct region *curr = new region;зачем new
    curr = begin;
    while (curr!=NULL)
  {
  Fout<<"\n"<<curr->regionX<<" "<<curr->type<<" "<<curr->krivizna<<" "<<curr->picet<<" "<<curr->plus;
  curr = curr->next;
  }
   Fout.close();
   //запись в файл элементов  uch_name.e01 сделали, теперь в elt_name
   //char* name=new char[80];
   double kriv; int j;
   /*strcpy (name,uch_name);
   int j=strlen(name)-1;
   name[j]='1'; name[j-1]='0'; name[j-2]='e';
   */
   struct elementy
  {double l_clot,kriv,l_circ;};
   elementy * el;
   el=new elementy[rQuantity];// с запасом
   int n_elts=0,pr; double l_first,l_last;
    Fout.open(elt_name);
    curr = begin;
    j=0;// номер анализируемого эл-та в curr
    if(curr->type==0)
    {l_first=curr->regionX; j++; curr = curr->next;}
     else  l_first=0.0;
      while (curr!=NULL)
       { if(curr->next!=NULL)pr=curr->next->type;else pr=-1;
     switch (curr->type)
          {
       case 0:// прямая
         if(curr->prev->type==0)
          { if(n_elts==0)l_first=curr->regionX; else
           el[n_elts-1].l_circ+= curr->regionX-curr->prev->regionX;
          }// прямая за прямой
          else {// впереди только окружность, ставлю нуль клотоиду
           el[n_elts].l_clot=0.0;
           el[n_elts].kriv=0.0;
           el[n_elts].l_circ=curr->regionX-curr->prev->regionX;
           j++;
           n_elts++;
               }
              break;
        case 1://клотоида
          if(j==0) el[n_elts].l_clot=curr->regionX;else
           el[n_elts].l_clot=curr->regionX-curr->prev->regionX;
           switch(pr)
            {
           case 0:// прямая за клотоидой
             el[n_elts].kriv=0.0;
             el[n_elts].l_circ=curr->next->regionX-curr->regionX;
              j=j+2;
              n_elts++;
             curr=curr->next;
              break;
              case 1: //клотоида за клотоидой
             el[n_elts].kriv=0.0;
             el[n_elts].l_circ=0.0;
             j++;
             n_elts++;
               break;
             case 2:    // окружность за клотоидой
              el[n_elts].kriv=curr->next->krivizna;
              el[n_elts].l_circ=curr->next->regionX-curr->regionX;
              j=j+2;
              n_elts++;
              curr=curr->next;
               break;
                 }//switch pr
               break;
        case 2://окружность ставлю впереди нулевую клотоиду + окружность
           el[n_elts].l_clot=0.0;
           el[n_elts].kriv=curr->krivizna;
           if(j==0) el[n_elts].l_circ=curr->regionX; else
           el[n_elts].l_circ=curr->regionX-curr->prev->regionX;
           j++;
           n_elts++;
           break;
             }//switch
             curr=curr->next;
           }// while
           // в итоге n_elts это количество новых элементов
           n_elts--;// последняя клотоида не считается
     // лишняя   l_last=el[n_elts].l_circ;
           Fout<<n_elts;
           Fout<<"\n"<<l_first;
           double s,s1,s2;
           s=l_first-200;
           if(s<0.0)s=20.0;
           s1=l_first+200.;
           Fout<<"\n"<<s<<" "<<s1<<"  "<<20.;
           for(j=0;j<n_elts;j++)
             {

             s= el[j].l_clot;
             if(s<0.1) s1=s2=s; else
             {
              s1=0.7*s;
              if(s1<20)s1=20;
              s2=1.3*s;
              if(s2>180)s2=180;
              }
              Fout<<"\n"<<el[j].l_clot<<" "<<s1<<" "<<s2;
             if(fabs(el[j].kriv)>0.00001)
             {
             kriv=1.0/el[j].kriv;
             s=  fabs(kriv);  //радиус
             s1=0.7*s; if(s1<200) s1=200;
             s2=1.3*s; if(s2>3000)s2=3000;
             }
              else
              {kriv=0.0;   s1=200; s2=3000;
              }

               Fout<<"\n"<<kriv<<" "<<s1<<" "<<s2;
               s=el[j].l_circ;
                if(s<0.1) s1=s2=s; else
                {
               s1=0.7*s; if(s1<20) s1=20;
               s2=1.3*s; if(s2>3000)s2=3000; //длина круговой
                 }
               Fout<<"\n"<<el[j].l_circ<<" "<<s1<<" "<<s2;
               Fout<<"\n"<<0;//возвышение наружного рельса
             }
                s=el[n_elts].l_clot;
                s1=0.7*s;
              if(s1<20)s1=20;
              s2=1.3*s;
              if(s2>180)s2=180;
         Fout<<"\n"<<el[n_elts].l_clot<<" "<<s1<<" "<<s2;

                Fout.close();
                delete (el);
//                delete(name);
                //где удалять список границ???
  return true;
}




