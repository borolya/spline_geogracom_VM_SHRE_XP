Перемещение границы
*************************************************************************/
struct region *editR = new region;
void TForm1::Move()
{
  if (isMove)
   {

      if (editR==begin)
      {
          if (Form1->x1>Xp(editR->next->regionX))
            {
              ShowMessage("Недопустимое перемещение");
              return;
            }
      }
      else
      {
       if ((Form1->x1>Xp(editR->next->regionX))||(Form1->x1<Xp(editR->prev->regionX)))
