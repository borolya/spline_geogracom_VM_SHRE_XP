/*********************************************************************
Рассчитать и отобразить проектную углограмму
**********************************************************************/
void TForm1::Project()
{

 double xs = 0; //начала участка
 double xe = 0; //конец участка
 double ys = 0; //начала участка
 double ye = 0; //конец участка
 Fild->Canvas->Pen->Color = clGreen;
 Fild->Canvas->Pen->Width = 2;
 //struct region *curr = new region;
        curr = begin;

    while (curr!=NULL)
     {
          if (curr->prev== NULL) //первая граница
          {
              xs = MPoint[0].x1;
  //  ys = MPoint[0].y1; //заменить на разность углов при начале не с существующего угла
     ys=dnugl;
     ye=ys;//добавил
          }
           xe = curr->regionX;
       //       xe = curr->regionX-10;;
         if(curr->next==NULL) xe = curr->regionX;

           if (curr->type == 0) //прямая
          {
                 Fild->Canvas->MoveTo(Xp(xs),Yp(ys));
      //         Fild->Canvas->LineTo(Xp(curr->regionX),Yp(ys));
                   Fild->Canvas->LineTo(Xp(xe),Yp(ys));
          }
          if (curr->type ==2) //окружность
          {
                Fild->Canvas->MoveTo(Xp(xs),Yp(ys));
                 ye = ys+curr->krivizna*(xe-xs);
                 Fild->Canvas->LineTo(Xp(xe),Yp(ye));
          }
          if (curr->type == 1)
          {
           Fild->Canvas->MoveTo(Xp(xs),Yp(ys));
          double xh = 0;
//             while (curr->regionX-(xh+xs)>0.1)
                  while (xe-(xh+xs)>0.01)
                   {
 ye = curr->prev->krivizna*xh+
 (curr->next->krivizna-curr->prev->krivizna)/
 (curr->regionX-curr->prev->regionX)*xh*xh/2+ys;
                       xh +=0.5;
                       Fild->Canvas->LineTo(Xp(xs+xh),Yp(ye));

                   }
          }//клотоида
          xs = xe;
          ys = ye;
          curr = curr->next;
          }
}

