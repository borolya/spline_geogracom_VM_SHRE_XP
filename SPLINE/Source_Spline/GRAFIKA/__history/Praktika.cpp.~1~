                        end = lend;
                        begin = lend;
                        Form1->rQuantity = 1;
    if (regime==0||regime==1)
    {
 //режим автoматического расчета или открытие сохраненного файла
 // - требуется читать из файла Uglogramma.txt теперь uch_name состыкован
